# Egnyte Go SDK v2 live integration test configuration.
#
# Copy this file to .env.integration, restrict its permissions, and fill in
# EGNYTE_DOMAIN plus exactly one authentication method below. Empty values are
# intentional: they cannot be mistaken for real credentials by the test.

export EGNYTE_DOMAIN=''

# If you already have a cached OAuth access token, place it here. It needs at
# least these scopes: Egnyte.filesystem Egnyte.link Egnyte.permission.
export EGNYTE_TOKEN=''

# If you do not already have an access token, leave EGNYTE_TOKEN empty and fill
# in all four values below. EGNYTE_KEY is the OAuth client ID and EGNYTE_SECRET
# is its client secret. The suite will obtain one access token through the
# Resource Owner Password flow and keep it in memory for this test run.
export EGNYTE_KEY=''
export EGNYTE_SECRET=''
export EGNYTE_USERNAME=''
export EGNYTE_PASSWORD=''

# Used when minting a token through the password flow. Egnyte.ai enables the
# optional hybrid-search check.
export EGNYTE_SCOPES='Egnyte.filesystem Egnyte.link Egnyte.permission Egnyte.ai'
